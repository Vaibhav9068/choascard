# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# JWT (use long random strings in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS — comma-separated allowed frontend origins (production)
# Include Vercel URL, e.g. https://choascard.vercel.app
CLIENT_URL=http://localhost:3000

# Brevo (formerly Sendinblue) Email Service — HTTP API, no SMTP ports needed
# EMAIL_USER = your verified sender email on Brevo (e.g. your Gmail)
# EMAIL_PASS = your Brevo API key (from https://app.brevo.com/settings/keys/api)
EMAIL_USER=
EMAIL_PASS=

# Optional: local socket test script (test_player.js)
SOCKET_URL=http://localhost:5000
# TEST_ACCESS_TOKEN=

# Optional: LAN dev IP for Next.js allowedDevOrigins (frontend)
# LAN_DEV_IP=192.168.1.6
