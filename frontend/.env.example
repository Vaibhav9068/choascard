# Safe to commit — copy to .env.local for local dev
# Next.js: only NEXT_PUBLIC_* vars are exposed to the browser

# Local backend (Express + Socket.IO on port 5000)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Production (Vercel) — set in Vercel dashboard, not in this file:
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-backend.onrender.com
